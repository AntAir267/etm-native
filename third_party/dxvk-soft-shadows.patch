+ir::SsaDef ResourceMap::emitSampleDrefFiltered(
+        ir::Builder&      builder,
+        ir::SsaDef        texCoord,
+        ir::SsaDef        reference,
+        ir::SsaDef        descriptor,
+        ir::SsaDef        sampler,
+        ir::SsaDef        lod,
+        uint32_t          filterSize) {
+  /* Smooth percentage-closer filtering from bilinear comparison samples
+   * (I. Castano's, as in The Witness): the coordinate in texels is split
+   * at the nearest texel corner, and each axis gets filterSize / 2 + 1
+   * sample positions and weights from the fraction s past that corner,
+   * placed so the bilinear weights add up to a kernel filterSize texels
+   * wide that slides with the coordinate (no steps at texel edges). */
+  auto f32 = ir::ScalarType::eF32;
+  auto c = [&] (float v) { return builder.makeConstant(v); };
+  auto add = [&] (ir::SsaDef a, ir::SsaDef b) { return builder.add(ir::Op::FAdd(f32, a, b)); };
+  auto sub = [&] (ir::SsaDef a, ir::SsaDef b) { return builder.add(ir::Op::FSub(f32, a, b)); };
+  auto mul = [&] (ir::SsaDef a, ir::SsaDef b) { return builder.add(ir::Op::FMul(f32, a, b)); };
+  auto div = [&] (ir::SsaDef a, ir::SsaDef b) { return builder.add(ir::Op::FDiv(f32, a, b)); };
+
+  auto sizeType = ir::Type()
+    .addStructMember(ir::ScalarType::eU32, 2u)  /* size   */
+    .addStructMember(ir::ScalarType::eU32);     /* layers */
+  auto sizeStruct = builder.add(ir::Op::ImageQuerySize(sizeType, descriptor, builder.makeConstant(0u)));
+  auto sizeF = builder.add(ir::Op::ConvertItoF(ir::BasicType(f32, 2u), ir::extractFromVector(builder, sizeStruct, 0u)));
+
+  struct Axis { ir::SsaDef size, base; std::array<ir::SsaDef, 4u> w, u; } axes[2];
+
+  for (uint32_t i = 0u; i < 2u; i++) {
+    Axis& a = axes[i];
+    a.size = ir::extractFromVector(builder, sizeF, i);
+
+    auto t = mul(ir::extractFromVector(builder, texCoord, i), a.size);
+    auto corner = builder.add(ir::Op::FRound(f32, add(t, c(0.5f)), ir::RoundMode::eNegativeInf));
+    auto s = sub(add(t, c(0.5f)), corner);
+    a.base = sub(corner, c(0.5f));        /* (in texels: the centre left of the corner) */
+
+    switch (filterSize) {
+      case 3u:
+        a.w[0] = sub(c(3.0f), mul(c(2.0f), s));
+        a.w[1] = add(c(1.0f), mul(c(2.0f), s));
+        a.u[0] = sub(div(sub(c(2.0f), s), a.w[0]), c(1.0f));
+        a.u[1] = add(div(s, a.w[1]), c(1.0f));
+        break;
+      case 5u:
+        a.w[0] = sub(c(4.0f), mul(c(3.0f), s));
+        a.w[1] = c(7.0f);
+        a.w[2] = add(c(1.0f), mul(c(3.0f), s));
+        a.u[0] = sub(div(sub(c(3.0f), mul(c(2.0f), s)), a.w[0]), c(2.0f));
+        a.u[1] = div(add(c(3.0f), s), c(7.0f));
+        a.u[2] = add(div(s, a.w[2]), c(2.0f));
+        break;
+      default: /* 7 (all four weights negative: their products are not) */
+        a.w[0] = sub(mul(c(5.0f), s), c(6.0f));
+        a.w[1] = sub(mul(c(11.0f), s), c(28.0f));
+        a.w[2] = sub(mul(c(-11.0f), s), c(17.0f));
+        a.w[3] = sub(mul(c(-5.0f), s), c(1.0f));
+        a.u[0] = sub(div(sub(mul(c(4.0f), s), c(5.0f)), a.w[0]), c(3.0f));
+        a.u[1] = sub(div(sub(mul(c(4.0f), s), c(16.0f)), a.w[1]), c(1.0f));
+        a.u[2] = add(div(sub(mul(c(-7.0f), s), c(5.0f)), a.w[2]), c(1.0f));
+        a.u[3] = sub(c(3.0f), div(s, a.w[3]));
+        break;
+    }
+  }
+
+  uint32_t taps = filterSize / 2u + 1u;
+  float total = filterSize == 3u ? 16.0f : filterSize == 5u ? 144.0f : 2704.0f;
+
+  /* One mip only matters here: explicit LOD 0 unless one was given */
+  if (!lod)
+    lod = c(0.0f);
+
+  auto sum = ir::SsaDef();
+
+  for (uint32_t j = 0u; j < taps; j++) {
+    for (uint32_t i = 0u; i < taps; i++) {
+      std::array<ir::SsaDef, 2u> coord = {
+        div(add(axes[0].base, axes[0].u[i]), axes[0].size),
+        div(add(axes[1].base, axes[1].u[j]), axes[1].size) };
+
+      auto sample = builder.add(ir::Op::ImageSample(f32, descriptor, sampler,
+        ir::SsaDef(), buildVector(builder, f32, 2u, coord.data()), ir::SsaDef(),
+        lod, ir::SsaDef(), ir::SsaDef(), ir::SsaDef(), ir::SsaDef(), reference));
+
+      auto term = mul(mul(axes[0].w[i], axes[1].w[j]), sample);
+      sum = sum ? add(sum, term) : term;
+    }
+  }
+
+  return mul(sum, c(1.0f / total));
+}
